#!/usr/bin/env bash
# Current loopback-only data and public-tool inspection UI.
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
project_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"
cd "$project_root"
export PYTHONDONTWRITEBYTECODE=1
exec python3 -m quant_data.canonical_inspector --project-root "$project_root" "$@"
