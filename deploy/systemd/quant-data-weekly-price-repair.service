[Unit]
Description=Quant Data weekly historical price gap repair
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/volatility/Python_Projects/Quant_Data_Infra/data/market.sqlite

[Service]
Type=oneshot
WorkingDirectory=/home/volatility/Python_Projects/Quant_Data_Infra
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m quant_data.operations.weekly_price_repair
TimeoutStartSec=61min
MemoryHigh=1536M
MemoryMax=2G
OOMPolicy=stop
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/volatility/Python_Projects/Quant_Data_Infra/data
