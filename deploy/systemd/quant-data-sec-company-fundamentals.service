[Unit]
Description=Quant Data weekday SEC company-fundamentals refresh
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/volatility/Python_Projects/Quant_Data_Infra/data/market.sqlite
ConditionPathExists=/home/volatility/Python_Projects/Quant_Data_Infra/data/company.sqlite

[Service]
Type=oneshot
WorkingDirectory=/home/volatility/Python_Projects/Quant_Data_Infra
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m quant_data.operations.sec_market_companyfacts_refresh
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/volatility/Python_Projects/Quant_Data_Infra/data
