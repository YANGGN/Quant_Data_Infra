[Unit]
Description=Quant Data incremental Equibles transcripts, 100 shared calls per day
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/volatility/Python_Projects/Quant_Data_Infra/data/company.sqlite
ConditionPathExists=/home/volatility/Python_Projects/Quant_Data_Infra/data/.operations/equibles-refresh/activation.json

[Service]
Type=oneshot
WorkingDirectory=/home/volatility/Python_Projects/Quant_Data_Infra
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m quant_data.operations.equibles_refresh
TimeoutStartSec=70min
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/volatility/Python_Projects/Quant_Data_Infra/data
