[Unit]
Description=Quant Data weekday SPY indicative option-surface refresh
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/volatility/Python_Projects/Quant_Data_Infra/data/market.sqlite

[Service]
Type=oneshot
WorkingDirectory=/home/volatility/Python_Projects/Quant_Data_Infra
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m quant_data.operations.alpaca_spy_options_refresh
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/volatility/Python_Projects/Quant_Data_Infra/data
